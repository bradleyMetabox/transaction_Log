# Neon POOLED connection string (host contains "-pooler"), used by the service at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Long random secret for the /admin routes (tenant creation, chain import, verify).
ADMIN_API_KEY=change-me-to-a-long-random-string
# Optional: connections per function instance (default 5).
PG_POOL_MAX=5
